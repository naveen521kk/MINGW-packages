_realname=file-find-rule
_dist=File-Find-Rule
pkgbase=mingw-w64-perl-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-perl-${_realname}")
pkgver=0.34
pkgrel=1
pkgdesc="command line wrapper to File::Find::Rule (mingw-w64)"
arch=('any')
url="https://metacpan.org/release/${_realname}"
groups=("${MINGW_PACKAGE_PREFIX}-perl-modules")
depends=(
  "${MINGW_PACKAGE_PREFIX}-perl"

  "${MINGW_PACKAGE_PREFIX}-perl-file-spec"

  "${MINGW_PACKAGE_PREFIX}-perl-number-compare"

  "${MINGW_PACKAGE_PREFIX}-perl-file-find"

  "${MINGW_PACKAGE_PREFIX}-perl-text-glob"

  "${MINGW_PACKAGE_PREFIX}-perl-test-more"

)
options=('!emptydirs')
makedepends=("${MINGW_PACKAGE_PREFIX}-python")
license=('unknown')
source=(
  "https://cpan.metacpan.org/authors/id/R/RC/RCLAMP/${_dist}-${pkgver}.tar.gz"
  "patchmakefile.py"
)
sha512sums=('97328a86578942d214f7ac530cc88fc84dc7ef2018db06b8c0c58907a4045e90c9c97d1848ed4f16838bd8ca591aca4fa9f24649c81fd8dfe9efe7a2f9f2722c'
            'd7ec5ba4a3d75f674f4028e8a53bc4177ab71a379bc63affebf910e1d5a0e491b6642318218b55ddc4d90e0125d61e4b97626782af57d44522bcb5543fb21cb2')

build() {
  cd "$srcdir/${_realname}-${pkgver}"
  PERL_MM_USE_DEFAULT=1 perl Makefile.PL
  export pkgdir=$pkgdir
  python $srcdir/patchmakefile.py
  mingw32-make
}

package() {
  cd "$srcdir/${_realname}-${pkgver}"
  mingw32-make DESTDIR="${pkgdir}/" install
}
