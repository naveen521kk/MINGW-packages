_realname=business-ismn
_dist=Business-ISMN
pkgbase=mingw-w64-perl-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-perl-${_realname}")
pkgver=1.202
pkgrel=1
pkgdesc="work with International Standard Music Numbers (mingw-w64)"
arch=('any')
url="https://metacpan.org/release/${_realname}"
groups=("${MINGW_PACKAGE_PREFIX}-perl-modules")
depends=(
  "${MINGW_PACKAGE_PREFIX}-perl"

  "${MINGW_PACKAGE_PREFIX}-perl-list-util"

  "${MINGW_PACKAGE_PREFIX}-perl-tie-cycle"

)
options=('!emptydirs')
makedepends=("${MINGW_PACKAGE_PREFIX}-python")
license=('artistic_2')
source=(
  "https://cpan.metacpan.org/authors/id/B/BD/BDFOY/${_dist}-${pkgver}.tar.gz"
  "patchmakefile.py"
)
sha512sums=('3f3dc2805f15edc92175c60fcf149e7a9558dd91a70173d559b298cedf177b92967f62581f16036a6c4269c3a5bec0d4bcd20a6ff9c13f4e17bec62fdca19ab2'
            'd7ec5ba4a3d75f674f4028e8a53bc4177ab71a379bc63affebf910e1d5a0e491b6642318218b55ddc4d90e0125d61e4b97626782af57d44522bcb5543fb21cb2')

build() {
  cd "$srcdir/${_realname}-${pkgver}"
  PERL_MM_USE_DEFAULT=1 perl Makefile.PL
  export pkgdir=$pkgdir
  python $srcdir/patchmakefile.py
  mingw32-make
}

package() {
  cd "$srcdir/${_realname}-${pkgver}"
  mingw32-make DESTDIR="${pkgdir}/" install
}
