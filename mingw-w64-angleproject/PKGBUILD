_realname=angleproject
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=97.0.4692.71
# blindly follow chromium version number
# see https://omahaproxy.appspot.com/all.json?os=win&channel=stable
# for the commit
# See the `true_branch` variable there and use the most recent commit
# from the branch(`chromium/<true_branch>`).
_commit="907d2234409b3507bbcf15f30177692f9204afaa"
pkgrel=1
pkgdesc="A conformant OpenGL ES implementation (mingw-w64)"
arch=('any')
mingw_arch=('mingw32' 'mingw64' 'ucrt64' 'clang64')
url="http://angleproject.org/"
license=("BSD")
makedepends=(
    "${MINGW_PACKAGE_PREFIX}-python"
    "${MINGW_PACKAGE_PREFIX}-ninja"
    "${MINGW_PACKAGE_PREFIX}-cc"
    "git"
)
depends=(
    "${MINGW_PACKAGE_PREFIX}-libpng"
    "${MINGW_PACKAGE_PREFIX}-libjpeg-turbo"
)
# All the commits for the sources should be taken from 
# DEPS file at the root of the project
source=("gn::git+https://gn.googlesource.com/gn#tag=90294ccdcf9334ed25a76ac9b67689468e506342"
    "${_realname}-${pkgver}.tar.gz::https://github.com/google/angle/archive/${_commit}.zip"
    "bare-clones/build::git+https://chromium.googlesource.com/chromium/src/build.git#commit=be7dd8702fc15ed385ba6d4c7111ca59bad58514"
    "bare-clones/depot_tools::git+https://chromium.googlesource.com/chromium/tools/depot_tools.git#commit=ab2e7f8f2e2199c8743862c6ed0c5f049861b308"
    "0001-gn-ninja-deletes-objs-workaround.patch"
    "0002-add-missing-limits.patch"
    "0003-remove-as-needed-from-ldflags.patch"
    "0004-add-mingw-toolchain-build.patch"
    "angle.pc"
)
sha256sums=('SKIP'
            'e29eb5fec66a68011770abe387154e978aa268bdc66f81d4c62abf530495e928'
            'SKIP'
            'SKIP'
            'b831576af25b275fca72851ec275c9d21bee0be29b4eb973a3e2a2580deac003'
            'd41ea264f389a34b3030ab5fb39107475a0e913123802dee241a20e1e5ecb1a5'
            '5d9998609ec6098401e395c8afaaddce52105c999489f27c906259b5cb47ce90'
